# Memos API Base URL
#
# For local development with iOS Simulator:
# EXPO_PUBLIC_MEMOS_API_URL=http://localhost:8081
#
# For Android Emulator (use 10.0.2.2 instead of localhost):
# EXPO_PUBLIC_MEMOS_API_URL=http://10.0.2.2:8081
#
# For physical devices (use your computer's IP address):
# EXPO_PUBLIC_MEMOS_API_URL=http://192.168.1.100:8081
#
# For production (use your server's domain):
# EXPO_PUBLIC_MEMOS_API_URL=https://memos.example.com

EXPO_PUBLIC_MEMOS_API_URL=http://localhost:8081
